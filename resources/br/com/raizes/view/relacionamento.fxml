<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.raizes.controller.RelacionamentoController"
            stylesheets="@../css/RelacionamentoEstilo.css, @../css/familia-preview.css"
            styleClass="root-relacionamento"
            prefWidth="1280" prefHeight="768">

    <center>
        <HBox spacing="8">
            <padding>
                <Insets top="20" right="24" bottom="24" left="24"/>
            </padding>

            <!-- ========================================================== -->
            <!-- 1. COLUNA ESQUERDA: FAMÍLIAS CADASTRADAS                   -->
            <!-- ========================================================== -->
            <VBox spacing="14" prefWidth="320" minWidth="320" styleClass="card-container">
                <padding>
                    <Insets top="18" right="16" bottom="18" left="16"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <VBox HBox.hgrow="ALWAYS">
                        <Label text="Núcleos Familiares" styleClass="secao-titulo"/>
                        <Label text="Cadastre e gerencie as famílias" styleClass="secao-subtitulo"/>
                    </VBox>
                    <Label fx:id="lblTotalFamilias" text="6" styleClass="badge-contador"/>
                </HBox>

                <!-- Barra de Pesquisa -->
                <TextField fx:id="txtBuscaFamilia" promptText="Buscar família..." styleClass="campo-pesquisa"/>

                <!-- Lista de Famílias (Substitui a tabela antiga) -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane-transparente">
                    <VBox fx:id="listaFamiliasContainer" spacing="8">
                        <!-- Itens carregados dinamicamente via Controller -->
                    </VBox>
                </ScrollPane>

                <!-- Botão Nova Família -->
                <Button fx:id="btnNovaFamilia" text="+ Nova Família" maxWidth="Infinity" 
                        onAction="#limparCampos" styleClass="button-novo"/>
            </VBox>

            <!-- ========================================================== -->
            <!-- 2. COLUNA CENTRAL: DADOS DA FAMÍLIA (FORMULÁRIO)            -->
            <!-- ========================================================== -->
            <VBox spacing="8" HBox.hgrow="ALWAYS" styleClass="card-container">
                <padding>
                    <Insets top="18" right="22" bottom="18" left="22"/>
                </padding>

                <!-- Cabeçalho do Formulário -->
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox HBox.hgrow="ALWAYS">
                        <Label text="Dados da Família" styleClass="secao-titulo"/>
                    </VBox>
                    <Label text="ID: --" fx:id="lblIdFamilia" styleClass="label-id"/>
                    <Label text="• Família nova" fx:id="lblStatusFamilia" styleClass="badge-status"/>
                </HBox>

                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane-transparente">
                    <VBox spacing="16">
                        
                        <!-- PAI -->
                        <VBox spacing="6">
                            <Label text="Pai *" styleClass="rotulo-campo"/>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <ComboBox fx:id="cmbPai" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                                <Button text="✕" onAction="#removerPai" styleClass="button-remover-item"/>
                            </HBox>
                        </VBox>

                        <!-- MÃE -->
                        <VBox spacing="6">
                            <Label text="Mãe *" styleClass="rotulo-campo"/>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <ComboBox fx:id="cmbMae" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                                <Button text="✕" onAction="#removerMae" styleClass="button-remover-item"/>
                            </HBox>
                        </VBox>

                        <!-- FILHOS -->
                        <VBox spacing="8">
                            <Label text="Filhos" styleClass="rotulo-campo"/>
                            <MenuButton fx:id="btnMenuFilhos" text="Pesquisar e adicionar filho..." maxWidth="Infinity" styleClass="menu-filhos"/>
                            
                            <VBox fx:id="containerFilhosAdicionados" spacing="6" styleClass="container-filhos-lista">
                                <!-- Lista dinâmica de filhos adicionados com botão de remover individual -->
                            </VBox>
                        </VBox>

                    </VBox>
                </ScrollPane>

                <!-- Botões de Ação Inferiores -->
                <HBox spacing="10" alignment="CENTER_RIGHT" styleClass="acoes-formulario">
                    <Button text="Limpar" onAction="#limparCampos" styleClass="button-acao"/>
                    <Button text="Excluir Família" fx:id="btnExcluir" onAction="#excluirRelacionamento" styleClass="button-perigo"/>
                    <Button text="Salvar Família" onAction="#salvarRelacionamento" styleClass="button-primario"/>
                </HBox>
            </VBox>

            <!-- ========================================================== -->
            <!-- 3. COLUNA DIREITA: VISUALIZAÇÃO DA FAMÍLIA                  -->
            <!-- ========================================================== -->
            <VBox spacing="8" prefWidth="430" minWidth="430" styleClass="card-container">
                <padding>
                    <Insets top="16" right="16" bottom="16" left="16"/>
                </padding>

                <Label text="Visualização da Família" styleClass="secao-titulo"/>

                <!-- Preview Gráfico do Casal e Filhos -->
                <VBox spacing="8" alignment="CENTER" styleClass="painel-preview-familia" VBox.vgrow="ALWAYS">
                    
                    <!-- Casal Preview -->
                    <HBox alignment="CENTER" spacing="6">
                        <VBox alignment="CENTER" spacing="2" maxWidth="95">
                            <Pane fx:id="avatarPaiPreview" styleClass="avatar-preview-grande"/>
                            <Label text="Pai" fx:id="lblPreviewNomePai" styleClass="preview-nome" wrapText="true" textAlignment="CENTER" maxWidth="100"/>
                        </VBox>
                        
                        <Label text="❤" styleClass="preview-coracao" textOverrun="CLIP" minWidth="20" alignment="CENTER"/>

                        <VBox alignment="CENTER" spacing="2" maxWidth="95">
                            <Pane fx:id="avatarMaePreview" styleClass="avatar-preview-grande"/>
                            <Label text="Mãe" fx:id="lblPreviewNomeMae" styleClass="preview-nome" wrapText="true" textAlignment="CENTER" maxWidth="100"/>
                        </VBox>
                    </HBox>

                    <!-- Estrutura de Conectores da Árvore -->
                    <VBox alignment="CENTER" spacing="0">
                        <!-- Linha vertical que desce do casal -->
                        <Region styleClass="linha-vertical-pai" />
                        
                        <!-- StackPane unindo a barra horizontal e o badge no mesmo espaço -->
                        <StackPane alignment="CENTER">
                            <Region fx:id="linhaHorizontalConector" styleClass="linha-horizontal-conector" />
                            <Label fx:id="lblPreviewTotalFilhos" text="0 filhos" styleClass="badge-total-filhos"/>
                        </StackPane>
                    </VBox>

                    <!-- Grelha de Filhos (Miniaturas) com mais espaçamento -->
                    <HBox fx:id="grelhaFilhosPreview" alignment="TOP_CENTER" spacing="12" styleClass="grelha-filhos-preview">
                        <!-- Preenchido dinamicamente pelo Controller -->
                    </HBox>

                    <Pane VBox.vgrow="ALWAYS"/>

                    <!-- Cartão Inspirador Rodapé -->
                    <VBox styleClass="card-citacao">
                        <Label text="“Família é a raiz que nos mantém firmes e as asas que nos permitem voar.”" styleClass="texto-citacao" wrapText="true"/>
                    </VBox>
                </VBox>

            </VBox>

        </HBox>
    </center>
</BorderPane>